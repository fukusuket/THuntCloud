# ── DuckDB ──────────────────────────────────────────
# Host path for DuckDB bind mount (SSD recommended).
# Leave commented out to use the default ./data/db (relative to docker-compose.yml).
#
# macOS / Linux: default ./data/db works out of the box.
#
# WSL2: the default relative path also works when running Docker Compose from
# within the WSL filesystem.  However, if you keep the project on the Windows
# filesystem (/mnt/c/...) or experience issues, set this to an absolute path:
#   DUCKDB_HOST_PATH=/home/youruser/THuntCloud/docker/data/db
#
# DUCKDB_HOST_PATH=./data/db

# ── Rust Logging ────────────────────────────────────
# Log level for ingester (trace, debug, info, warn, error)
RUST_LOG=info

# ── Ingester build mode ──────────────────────────────
# By default the ingester image uses a pre-built binary from GitHub Releases
# (INGESTER_BUILD_TARGET=prebuilt-runtime, INGESTER_VERSION=v0.1.0).
# Most users do NOT need to change anything here.
#
# The binary is downloaded from:
#   https://github.com/fukusuket/THuntCloud/releases/download/<INGESTER_VERSION>/ingester-<arch>-linux
#
# Docker BuildKit detects the host architecture automatically (TARGETARCH) and
# selects the correct binary — no extra configuration needed:
#
#   Platform                          | Binary downloaded        | Execution
#   ----------------------------------|--------------------------|----------
#   macOS Intel (x86_64)             | ingester-x86_64-linux    | Native
#   macOS Apple Silicon (arm64)       | ingester-aarch64-linux   | Native
#   Linux x86_64                      | ingester-x86_64-linux    | Native
#   WSL2 on x86_64 Windows (Ubuntu)   | ingester-x86_64-linux    | Native
#   WSL2 on arm64 Windows             | ingester-aarch64-linux   | Native
#
# ── Override examples ────────────────────────────────
# Use a different release version:
#   INGESTER_VERSION=v0.1.10
#
# Revert to a source build (e.g. for local development / debugging):
#   INGESTER_BUILD_TARGET=runtime

# ── Superset ────────────────────────────────────────
# Secret key for Superset (change in production!)
SUPERSET_SECRET_KEY=change-me-in-production
