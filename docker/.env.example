# THuntCloud Environment Variables
# Copy this file to .env and fill in the values.

# ── OpenAI API ──────────────────────────────────────
# Required: Your OpenAI API key
OPENAI_API_KEY=sk-your-api-key-here

# AI model for SQL generation and analysis (default: gpt-5.4)
OPENAI_MODEL=gpt-5.4

# Lightweight model for quick tasks (default: gpt-5.4-mini)
OPENAI_MODEL_LITE=gpt-5.4-mini

# ── DuckDB ──────────────────────────────────────────
# Host path for DuckDB bind mount (SSD recommended).
# Leave commented out to use the default ./data/db (relative to docker-compose.yml).
#
# macOS / Linux: default ./data/db works out of the box.
#
# WSL2: the default relative path also works when running Docker Compose from
# within the WSL filesystem.  However, if you keep the project on the Windows
# filesystem (/mnt/c/...) or experience issues, set this to an absolute path:
#   DUCKDB_HOST_PATH=/home/youruser/THuntCloud/docker/data/db
#
# DUCKDB_HOST_PATH=./data/db

# ── Rust Logging ────────────────────────────────────
# Log level for ingester (trace, debug, info, warn, error)
RUST_LOG=info

# ── Superset ────────────────────────────────────────
# Secret key for Superset (change in production!)
SUPERSET_SECRET_KEY=change-me-in-production
