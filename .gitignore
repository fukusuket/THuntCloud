# ── Rust ────────────────────────────────────────────
# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# ── Secrets / Environment variables ─────────────────
.env
.env.local
.env.*.local

# ── Python ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
*.venv
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ── DuckDB ──────────────────────────────────────────
*.db
*.db.wal
*.mmdb
docker/data/*
!docker/data/db/
docker/data/db/*
!docker/data/db/.gitkeep

# ── macOS ────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverrideAttribute

# ── IDE ──────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── Docker ───────────────────────────────────────────
docker/logs/*
!docker/logs/.gitkeep
*.gz
